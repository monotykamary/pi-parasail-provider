{
  "name": "pi-parasail-provider",
  "version": "1.0.34",
  "description": "Parasail provider extension for pi - Access top open-source models (DeepSeek, Qwen, GLM, Kimi, Llama, Gemma, Mistral) through the Parasail API",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "clean": "echo 'nothing to clean'",
    "build": "echo 'nothing to build'",
    "check": "tsc --noEmit && vitest run && node scripts/test-pi-compat.mjs",
    "test": "vitest run",
    "update-models": "node scripts/update-models.js",
    "test:pi": "node scripts/test-pi-compat.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pi",
    "extension",
    "provider",
    "parasail",
    "ai",
    "llm",
    "deepseek",
    "qwen",
    "glm",
    "kimi",
    "llama",
    "gemma",
    "mistral"
  ],
  "author": "",
  "license": "MIT",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "overrides": {
    "brace-expansion": "5.0.12"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "typescript": "6.0.3",
    "@types/node": "^25.9.1",
    "vitest": "4.1.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  }
}
